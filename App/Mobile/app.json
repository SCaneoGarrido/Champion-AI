{
  "expo": {
    "name": "Champion AI",
    "slug": "champion-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.championai.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "Champion AI necesita el micrófono para transcribir tu voz.",
        "NSPhotoLibraryUsageDescription": "Champion AI necesita acceso a tu galería para cambiar la foto de perfil."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.championai.app",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.READ_MEDIA_IMAGES"
      ]
    },
    "scheme": "championai",
    "plugins": ["expo-screen-orientation"]
  }
}
